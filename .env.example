# ---------------------------------------------------------------------------
# Copy to .env (repository root) and edit.  .env is git-ignored.
#   Linux/macOS :  cp .env.example .env
#   Windows     :  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Allowed CORS origins for the UI (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- persistence -----------------------------------------------------------
# Relative SQLite paths are resolved against backend/ so that the API, the
# scripts and the tests always share the same file.
#   DATABASE_URL=sqlite:///./npi.db
#   DATABASE_URL=postgresql://npi:npi@localhost:5432/npi
DATABASE_URL=sqlite:///./npi.db

# Seed the four synthetic demo programs when the database is empty
SEED_DEMO_ON_STARTUP=true

# --- security --------------------------------------------------------------
# Signs JWTs and derives the Fernet key for provider credentials.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-you-deploy
# true = JWT bearer tokens, roles and per-project access control
AUTH_ENABLED=false
ACCESS_TOKEN_MINUTES=720
# Only used to create the demo administrator; ignored when ENVIRONMENT=production
# DEMO_ADMIN_PASSWORD=change-me-too

# --- background jobs -------------------------------------------------------
JOB_WORKERS=2

# --- simulation limits -----------------------------------------------------
SIMULATION_MAX_ITERATIONS=50000
SIMULATION_MAX_TASKS=2000
MAX_UPLOAD_BYTES=10485760

# --- AI copilot ------------------------------------------------------------
# offline | ollama | openai | anthropic | openrouter | custom
AI_ACTIVE_PROVIDER=offline
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MONTHLY_BUDGET_USD=25
# Used to estimate cost when a provider does not report it (USD per million tokens)
AI_PRICE_PER_MTOK_INPUT_USD=0
AI_PRICE_PER_MTOK_OUTPUT_USD=0

# Local models (Ollama) — nothing leaves the machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Hosted providers
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_KEY=

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint (self-hosted gateway, router, proxy)
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
