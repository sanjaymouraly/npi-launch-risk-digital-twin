{
  "name": "npi-risk-digital-twin-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsc --noEmit && vite build",
